{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://34-201-93-148.sslip.io/api/:path*" },
    { "source": "/media/:path*", "destination": "https://34-201-93-148.sslip.io/media/:path*" }
  ],
  "headers": [
    { "source": "/api/:path*", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] },
    { "source": "/media/:path*", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] }
  ]
}
