# Copy to .env.local and adjust.

# mock: the app runs on the in-browser mock database (no backend needed)
# live: every call goes to the API gateway
NEXT_PUBLIC_API_MODE=mock

# Leave empty to call same-origin /api/* (recommended). Next.js forwards those to API_GATEWAY_INTERNAL_URL.
# Set a full origin (https://api.shapepotentialafrica.org) only if the gateway is on another domain and has CORS set up.
NEXT_PUBLIC_API_GATEWAY_URL=

# Where the Next.js server forwards /api/* and /media/* (server-side only)
API_GATEWAY_INTERNAL_URL=http://localhost:8080

# Simulated latency for mock mode, in milliseconds
NEXT_PUBLIC_MOCK_LATENCY_MS=220
